---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { excerpt } from '../../lib/excerpt';
import { getReadingOrderPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = getReadingOrderPosts(await getCollection('blog'));
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			// posts 는 발행 시각 오름차순. 다음 글 = 시간상 더 나중 글, 이전 글 = 더 이른 글.
			newer: posts[i + 1] ?? null,
			older: posts[i - 1] ?? null,
		},
	}));
}
type Props = {
	post: CollectionEntry<'blog'>;
	newer: CollectionEntry<'blog'> | null;
	older: CollectionEntry<'blog'> | null;
};

const { post, newer, older } = Astro.props as Props;
const { Content } = await render(post);
const description = post.data.description ?? excerpt(post.body);
const toNav = (p: Props['newer']) => (p ? { id: p.id, title: p.data.title } : undefined);
---

<BlogPost
	{...post.data}
	description={description}
	body={post.body}
	next={toNav(newer)}
	prev={toNav(older)}
>
	<Content />
</BlogPost>
